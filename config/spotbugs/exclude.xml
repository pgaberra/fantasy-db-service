<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Noise in a Spring/record codebase, not actionable defects:
         SPRING_ENDPOINT flags every @RequestMapping method; EI_EXPOSE_REP(2)
         flags components storing injected beans and records/entities holding lists. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT,EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- SERVLET_HEADER: InternalApiKeyFilter reads the X-Internal-Api-Key request
         header by design (the inter-service auth check), not a vulnerability. -->
    <Match>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!-- IMPROPER_UNICODE fires on any case-insensitive comparison, on the grounds that exotic
         characters can case-fold into ASCII. Usernames are validated to ^[A-Za-z0-9_]+$ before
         they reach this comparison, so there is no non-ASCII input for that to happen with; the
         comparison exists so an account may restyle the case of its own name. Scoped to the one
         method, so a genuine case-folding hazard elsewhere is still caught. -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
        <Class name="com.fantasy.db.user.UserService"/>
        <Method name="setUsername"/>
    </Match>

</FindBugsFilter>
